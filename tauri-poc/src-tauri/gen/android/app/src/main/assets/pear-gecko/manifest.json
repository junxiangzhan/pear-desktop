{
  "manifest_version": 2,
  "name": "Pear GeckoView",
  "version": "0.2",
  "description": "Runs Pear Desktop's renderer bundle in music.youtube.com (GeckoView build).",
  "browser_specific_settings": {
    "gecko": { "id": "pear-gecko@pear-devs.github.io" }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "https://music.youtube.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["report.js"],
      "run_at": "document_idle"
    }
  ]
}
