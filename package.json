{
  "name": "youtube-music",
  "desktopName": "com.github.th-ch.youtube-music",
  "productName": "YouTube Music",
  "version": "3.12.0",
  "description": "YouTube Music Desktop App - including custom plugins",
  "type": "module",
  "license": "MIT",
  "repository": "pear-devs/pear-desktop",
  "author": {
    "name": "th-ch",
    "email": "th-ch@users.noreply.github.com",
    "url": "https://github.com/pear-devs/pear-desktop"
  },
  "scripts": {
    "build": "vite build -c tauri-poc/vite.inject.config.mts",
    "clean": "pnpm del-cli tauri-poc/src-tauri/inject",
    "lint": "pnpm oxlint --type-aware src",
    "format": "pnpm oxfmt --write src",
    "format:check": "pnpm oxfmt --check src",
    "changelog": "pnpm dlx auto-changelog",
    "typecheck": "pnpm tsc -p tsconfig.json --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@dehoist/romanize-thai": "1.0.0",
    "@floating-ui/dom": "1.7.6",
    "@foobar404/wave": "2.0.5",
    "@indic-transliteration/sanscript": "1.3.3",
    "@mdui/icons": "1.0.3",
    "@skyra/jaro-winkler": "1.1.1",
    "bgutils-js": "3.2.0",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "chinese-conv": "4.0.0",
    "color": "5.0.3",
    "deepmerge-ts": "7.1.5",
    "es-hangul": "2.3.8",
    "fast-average-color": "9.5.2",
    "hanja": "1.1.5",
    "i18next": "26.3.3",
    "keyboardevent-from-electron-accelerator": "2.0.0",
    "keyboardevents-areequal": "0.2.2",
    "kuromoji": "0.1.2",
    "kuroshiro": "1.2.0",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "lazy-var": "2.2.2",
    "mdui": "2.1.4",
    "peerjs": "1.5.5",
    "pinyin-pro": "3.28.1",
    "solid-element": "1.9.1",
    "solid-floating-ui": "0.3.1",
    "solid-js": "1.9.13",
    "solid-styled-components": "0.28.5",
    "solid-transition-group": "0.3.0",
    "tinyld": "1.3.4",
    "virtua": "0.49.1",
    "vudio": "2.1.1",
    "youtubei.js": "17.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/trusted-types": "2.0.7",
    "builtin-modules": "5.2.0",
    "del-cli": "7.0.0",
    "discord-api-types": "0.38.49",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-solid": "0.14.5",
    "glob": "13.0.6",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "0.23.0",
    "ts-morph": "28.0.0",
    "typescript": "7.0.1-rc",
    "vite": "8.1.0",
    "vite-plugin-resolve": "2.5.2",
    "vite-plugin-solid": "2.11.12"
  },
  "auto-changelog": {
    "hideCredit": true,
    "package": true,
    "unreleased": true,
    "output": "changelog.md"
  }
}
